{
  "name": "eril/sql-migrator",
  "description": "Simple SQL-first migrations for PHP.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Eril\\SqlMigrator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eril\\SqlMigrator\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/sql-migrator"
  ],
  "require": {
    "php": "^8.1",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "phpunit"
  }
}
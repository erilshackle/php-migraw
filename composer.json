{
  "name": "eril/migraw",
  "description": "Simple SQL-first migrations for PHP.",
  "keywords": [
    "sql",
    "migration",
    "migrations",
    "database",
    "pdo",
    "mysql",
    "sqlite",
    "postgresql",
    "sqlsrv",
    "schema",
    "cli"
  ],
  "homepage": "https://github.com/erilshackle/php-migraw",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Eril TS Carvalho",
      "email": "erilandocarvalho@gmail.com",
      "homepage": "https://github.com/erilshackle",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/erilshackle/php-migraw/issues",
    "source": "https://github.com/erilshackle/php-migraw"
  },
  "funding": [],
  "require": {
    "php": "^8.1",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Eril\\Migraw\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eril\\Migraw\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/migraw"
  ],
  "scripts": {
    "migraw": "bin/migraw",
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
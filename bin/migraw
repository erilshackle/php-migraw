#!/usr/bin/env php
<?php

/**
 * --------------------------------------------------------------------------
 * Migraw - Sql Raw Migrations
 * --------------------------------------------------------------------------
 *
 * Simple SQL-first migrations for PHP.
 *
 * This file is the command-line entry point responsible for:
 * [Commands]
 *  init       Create the default migraw.php config file
 *  migrate    Run pending migrations
 *  rollback   Rollback the last migration batch
 *  status     Show migration status
 *  reset      Rollback all executed migrations
 *  fresh      Safe refresh: reset then migrate
 *  make       Create a new migration file
 *
 * @author Eril TS Carvalho
 * @copyright Copyright (c) 2026 Eril TS Carvalho
 * @license MIT
 * @version v0.1
 *
 * @link https://github.com/erilshackle/php-migraw
 *
 * --------------------------------------------------------------------------
 */

use Eril\Migraw\Console;
use Eril\Migraw\MigrationCreator;
use Eril\Migraw\MigrationRepository;
use Eril\Migraw\SeederCreator;
use Eril\Migraw\SeederRunner;
use Eril\Migraw\Migrator;

require_once 'vendor/autoload.php';

$args = $_SERVER['argv'];

$command = $args[1] ?? null;

$dryRun = in_array('--dry-run', $args, true) || in_array('--pretend', $args, true);

$force = in_array('--force', $args, true);

try {
    if (in_array($command, ['init', '--init'], true)) {
        initConfig($force);
        exit(0);
    }

    if ($command !== null && str_starts_with($command, 'init:')) {
        $driver = substr($command, strlen('init:'));
        initConfig($force, $driver);
        exit(0);
    }

    $defaultBootstrap = basePath('bootstrap.php');

    if (file_exists($defaultBootstrap)) {
        require_once $defaultBootstrap;
    }

    $configPath = basePath('migraw.php');

    if (! file_exists($configPath)) {
        echo "Config file not found: migraw.php\n";
        echo Console::bold("Run: php vendor/bin/migraw init\n");
        exit(1);
    }

    $config = require $configPath;

    if (isset($config['bootstrap'])) {
        $bootstrap = resolvePath($config['bootstrap']);

        if (file_exists($bootstrap)) {
            require_once $bootstrap;
        }
    }

    $pdo = resolvePdo($config);

    $path = resolvePath($config['path'] ?? 'database/migrations');
    $seedersPath = resolvePath($config['seeders_path'] ?? 'database/seeders');
    $table = $config['table'] ?? 'migrations';

    $repository = new MigrationRepository($pdo, $table);
    $migrator = new Migrator($pdo, $path, $repository);

    if ($force) {
        $migrator->force();
    }

    if ($dryRun) {
        $migrator->pretend();
    }

    if ($command === null) {
        confirmAndMigrate($migrator);
        exit(0);
    }

    match ($command) {
        'migrate', 'up' => migrate($migrator, $dryRun),
        'rollback', 'down' => rollback($migrator, $dryRun),
        'status' => status($migrator),
        'reset' => resetMigrations($migrator, $dryRun),
        'fresh' => fresh($migrator, $dryRun),
        'make' => make($path, $args[2] ?? null),
        'seed' => seed($migrator, $seedersPath, $args[2] ?? null),
        'seed:make' => makeSeeder($seedersPath, $args[2] ?? null),
        'help', '--help', '-h' => help(),
        default => unknownCommand($command),
    };
} catch (Throwable $e) {
    echo Console::red(
        "Error: {$e->getMessage()}\n"
    );
    exit(1);
}

function migrate(Migrator $migrator, bool $dryRun = false): void
{
    $executed = $migrator->migrate();

    if ($executed === []) {
        echo "Nothing to migrate.\n";
        return;
    }

    if ($dryRun) {
        printPretendedSql($migrator);
        return;
    }

    foreach ($executed as $migration) {
        echo Console::green(
            "Migrated: {$migration}\n"
        );
    }
}

function seed(Migrator $migrator, string $path, ?string $name = null): void
{
    $runner = new SeederRunner($migrator, $path);

    $executed = $runner->run($name);

    if ($executed === []) {
        echo "No seeders found.\n";
        return;
    }

    foreach ($executed as $seeder) {
        echo Console::green("Seeded: {$seeder}\n");
    }
}

function rollback(Migrator $migrator, bool $dryRun = false): void
{
    $rolledBack = $migrator->rollback();

    if ($rolledBack === []) {
        echo "Nothing to rollback.\n";
        return;
    }

    if ($dryRun) {
        printPretendedSql($migrator);
        return;
    }

    foreach ($rolledBack as $migration) {
        echo Console::yellow(
            "Rolled back: {$migration}\n"
        );
    }
}

function confirmAndMigrate(Migrator $migrator): void
{
    $pending = $migrator->pending();

    echo Console::bold(
        "Migraw - SQL-first migrations for PHP\n\n"
    );

    if ($pending === []) {
        echo "Nothing to migrate.\n";
        return;
    }

    echo "Pending migrations:\n\n";

    foreach ($pending as $migration) {
        echo Console::gray("  - {$migration}\n");
    }

    echo Console::bold("\nRun these migrations? [y/N]: ");

    $answer = trim(fgets(STDIN));

    if (! in_array(strtolower($answer), ['y', 'yes'], true)) {
        echo "Cancelled.\n";
        return;
    }

    echo "\n";

    $executed = $migrator->migrate();

    foreach ($executed as $migration) {
        echo Console::green("Migrated: {$migration}\n");
    }
}

function resetMigrations(Migrator $migrator, bool $dryRun = false): void
{
    $rolledBack = $migrator->reset();

    if ($rolledBack === []) {
        echo "Nothing to reset.\n";
        return;
    }

    if ($dryRun) {
        printPretendedSql($migrator);
        return;
    }

    foreach ($rolledBack as $migration) {
        echo "Rolled back: {$migration}\n";
    }
}


function fresh(Migrator $migrator, bool $dryRun = false): void
{
    $result = $migrator->fresh();

    if ($result['rolled_back'] === [] && $result['migrated'] === []) {
        echo "Nothing to fresh.\n";
        return;
    }

    if ($dryRun) {
        printPretendedSql($migrator);
        return;
    }

    foreach ($result['rolled_back'] as $migration) {
        echo "Rolled back: {$migration}\n";
    }

    foreach ($result['migrated'] as $migration) {
        echo "Migrated: {$migration}\n";
    }
}

function status(Migrator $migrator): void
{
    $rows = $migrator->status();

    if ($rows === []) {
        echo "No migrations found.\n";
        return;
    }

    foreach ($rows as $row) {
        $status = match ($row['status']) {
            'ran' => Console::green('[ran]'),
            'pending' => Console::yellow('[pending]'),
            'modified' => Console::red('[modified]'),
            default => "[{$row['status']}]",
        };

        printf(
            "%-14s %s\n",
            $status,
            $row['migration']
        );
    }
}

function make(string $path, ?string $name): void
{
    if (! $name) {
        echo "Migration name is required.\n";
        echo "Usage: vendor/bin/migraw make create_users_table\n";
        exit(1);
    }

    $creator = new MigrationCreator($path);
    $file = str_replace((string)getcwd(), '', $creator->create($name));

    echo "Created migration: {$file}\n";
}

function makeSeeder(string $path, ?string $name): void
{
    if (! $name) {
        echo "Seeder name is required.\n";
        echo "Usage: vendor/bin/migraw make:seeder AdminSeeder\n";
        exit(1);
    }

    $creator = new SeederCreator($path);
    $file = $creator->create($name);

    echo "Created seeder: {$file}\n";
}

function resolvePdo(array $config): \PDO
{
    $pdo = $config['pdo'] ?? $config['connection'] ?? null;

    if (is_callable($pdo)) {
        $pdo = $pdo();
    }

    if ($pdo instanceof \PDO) {
        return $pdo;
    }

    if (! is_array($pdo)) {
        throw new RuntimeException('Database connection must be a \PDO instance, callable, or connection array.');
    }

    return createPdoFromConnection($pdo, $config['options'] ?? []);
}

function createPdoFromConnection(array $connection, array $options = []): \PDO
{
    $driver = $connection['driver'] ?? 'mysql';

    $options = $options + [
        \PDO::ATTR_ERRMODE => \PDO::ERRMODE_EXCEPTION,
        \PDO::ATTR_DEFAULT_FETCH_MODE => \PDO::FETCH_ASSOC,
        \PDO::ATTR_EMULATE_PREPARES => false,
    ];

    $dsn = match ($driver) {
        'sqlite' => 'sqlite:' . resolvePath(
            $connection['sqlite_path'] ?? 'database/database.sqlite'
        ),

        'pgsql' => sprintf(
            'pgsql:host=%s;port=%s;dbname=%s',
            $connection['host'] ?? '127.0.0.1',
            $connection['port'] ?? '5432',
            $connection['database'] ?? ''
        ),

        'mysql' => sprintf(
            'mysql:host=%s;port=%s;dbname=%s;charset=%s',
            $connection['host'] ?? '127.0.0.1',
            $connection['port'] ?? '3306',
            $connection['database'] ?? '',
            $connection['charset'] ?? 'utf8mb4'
        ),

        default => throw new RuntimeException("Unsupported database driver: {$driver}"),
    };

    $username = $driver === 'sqlite'
        ? null
        : ($connection['username'] ?? null);

    $password = $driver === 'sqlite'
        ? null
        : ($connection['password'] ?? null);

    return new \PDO($dsn, $username, $password, $options);
}

function printPretendedSql(Migrator $migrator): void
{
    $sql = $migrator->getPretendedSql();

    if ($sql === []) {
        echo "No SQL to display.\n";
        return;
    }

    echo Console::cyan(
        "Dry run:\n\n"
    );

    foreach ($sql as $statement) {
        echo trim($statement) . "\n\n";
    }
}

function initConfig(bool $forced, string $driver = 'mysql'): void
{
    $configPath = basePath('migraw.php');

    if (!$forced && file_exists($configPath)) {
        echo "Config file already exists: migraw.php\n";
        return;
    }

    file_put_contents($configPath, defaultConfigStub($driver));

    if (! is_dir(basePath('database/migrations'))) {
        mkdir(basePath('database/migrations'), 0775, true);
    }

    if (! is_dir(basePath('database/seeders'))) {
        mkdir(basePath('database/seeders'), 0775, true);
        echo "Created directory: database/seeders\n";
    }

    echo Console::green("Created config: migraw.php\n");

    if (! is_dir(basePath('database/migrations'))) {
        mkdir(basePath('database/migrations'), 0775, true);

        echo Console::green(
            "Created directory: database/migrations\n"
        );
    }
}

function defaultConfigStub(string $driver = 'mysql'): string
{
    $driver = strtolower($driver);
    $connection = match ($driver) {

        'sqlite' => <<<'PHP'
'connection' => [
        'driver' => 'sqlite',
        'sqlite_path' => 'database/database.sqlite',
    ]
PHP,

        'pgsql' => <<<'PHP'
'connection' => [
        'driver' => $_ENV['DB_CONNECTION'] ?? 'pgsql',

        'host' => $_ENV['DB_HOST'] ?? '127.0.0.1',
        'port' => $_ENV['DB_PORT'] ?? '5432',
        'database' => $_ENV['DB_DATABASE'] ?? '',
        'username' => $_ENV['DB_USERNAME'] ?? 'postgres',
        'password' => $_ENV['DB_PASSWORD'] ?? '',
    ]
PHP,

        'mysql' => <<<'PHP'
'connection' => [
        'driver' => $_ENV['DB_CONNECTION'] ?? 'mysql',

        'host' => $_ENV['DB_HOST'] ?? '127.0.0.1',
        'port' => $_ENV['DB_PORT'] ?? '3306',
        'database' => $_ENV['DB_DATABASE'] ?? '',
        'username' => $_ENV['DB_USERNAME'] ?? 'root',
        'password' => $_ENV['DB_PASSWORD'] ?? '',

        'charset' => $_ENV['DB_CHARSET'] ?? 'utf8mb4',
    ]
PHP,

        default => <<<'PHP'
'connection' => [
        'driver' => $_ENV['DB_CONNECTION'] ?? 'sqlite',

        'host' => $_ENV['DB_HOST'] ?? '127.0.0.1',
        'port' => $_ENV['DB_PORT'] ?? '3306',
        'database' => $_ENV['DB_DATABASE'] ?? '',
        'username' => $_ENV['DB_USERNAME'] ?? 'root',
        'password' => $_ENV['DB_PASSWORD'] ?? '',
        'charset' => $_ENV['DB_CHARSET'] ?? 'utf8mb4',
        
        'sqlite_path' => 'database/database.sqlite',
    ]
PHP
    };

    return <<<PHP
<?php

return [

    /*
    |--------------------------------------------------------------------------
    | Bootstrap File
    |--------------------------------------------------------------------------
    |
    | Optional file loaded before the migrator starts.
    | Useful for loading environment variables, constants,
    | framework bootstrap files, or application services.
    |
    */

    // 'bootstrap' => 'bootstrap.php',

    /*
    |--------------------------------------------------------------------------
    | Migrations Path
    |--------------------------------------------------------------------------
    |
    | Directory where your migration files are stored.
    |
    */

    'path' => 'database/migrations',
    'seeders_path' => 'database/seeders',

    /*
    |--------------------------------------------------------------------------
    | Database Connection
    |--------------------------------------------------------------------------
    |
    | You may configure the connection using:
    |
    | You may configure the connection using an array, a PDO instance,
    | or a callable that returns a PDO instance.
    |
    */

    {$connection},

];

PHP;
}

function resolvePath(string $path): string
{
    if (isAbsolutePath($path)) {
        return $path;
    }

    return basePath($path);
}

function basePath(string $path = ''): string
{
    $base = getcwd();

    if ($path === '') {
        return $base;
    }

    return $base . DIRECTORY_SEPARATOR . str_replace(['/', '\\'], DIRECTORY_SEPARATOR, ltrim($path, '/\\'));
}

function isAbsolutePath(string $path): bool
{
    return str_starts_with($path, '/')
        || preg_match('/^[A-Za-z]:[\/\\\\]/', $path) === 1;
}

function unknownCommand(string $command): void
{
    echo "Unknown command: {$command}\n\n";

    help();

    exit(1);
}

function help(): void
{
    echo <<<TXT
Migraw

Usage:
  php vendor/bin/migraw init
  php vendor/bin/migraw init:sqlite
  php vendor/bin/migraw init:mysql
  php vendor/bin/migraw init:pgsql
  
  php vendor/bin/migraw make migration_name
  php vendor/bin/migraw seed:make AdminSeeder
  
  php vendor/bin/migraw migrate
  php vendor/bin/migraw up

  php vendor/bin/migraw rollback
  php vendor/bin/migraw down

  php vendor/bin/migraw seed
  php vendor/bin/migraw seed AdminSeeder

  php vendor/bin/migraw status
  php vendor/bin/migraw reset
  php vendor/bin/migraw fresh

Commands:
  init              Create the default migraw.php config file
  make              Create a new migration file
  status            Show migration status
  migrate, up       Run pending migrations
  rollback, down    Rollback the last migration batch
  reset             Rollback all executed migrations
  fresh             Reset and run all migrations again
  seed              Run all seeders or a specific seeder
  seed:make         Create a new seeder file

Options:
  --dry-run, --pretend   Show SQL without executing it
  --force                Force execution, ignoring safety checks.

TXT;
}
